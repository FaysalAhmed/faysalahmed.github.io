---
import BlogLayout from '../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const postThumbnails = [
  '/images/insight-architecture.jpg',
  '/images/insight-cloud.jpg',
  '/images/service-security.jpg',
  '/images/consulting-audit.jpg'
];

const services = [
  {
    image: '/images/service-cloud.jpg',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>`,
    title: 'Cloud Migration & Infrastructure Engineering',
    outcome: 'Zero downtime · Up to 40% cloud cost reduction',
    description: 'Design and execute resilient, zero-downtime migrations to AWS, GCP, and Azure. Implement Infrastructure as Code (Terraform) and auto-scaling container orchestration with Kubernetes.',
    highlights: [
      'Cloud Readiness & Architecture Audits',
      'Kubernetes (EKS/GKE) & Container Cluster Design',
      'Automated CI/CD Pipelines & GitOps Workflows',
      'FinOps: Cloud Cost Optimization & Rightsizing'
    ]
  },
  {
    image: '/images/service-architecture.jpg',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
    title: 'Enterprise Architecture & System Modernization',
    outcome: 'Eliminate scaling bottlenecks · High throughput',
    description: 'Deconstruct monoliths into fault-tolerant, decoupled microservices. Architect high-throughput, event-driven backends capable of serving millions of concurrent requests.',
    highlights: [
      'Monolith-to-Microservices Decomposition Roadmaps',
      'Event-Driven Systems (Kafka, RabbitMQ, SQS)',
      'Database Sharding, Read-Replicas & Redis Caching',
      'REST, GraphQL & gRPC API Ecosystem Design'
    ]
  },
  {
    image: '/images/service-security.jpg',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Cybersecurity, Zero-Trust & DevSecOps',
    outcome: 'Hardened attack surface · Regulatory compliance',
    description: 'Bake security directly into your engineering workflows. Identify threat surfaces, implement zero-trust access control, and prepare your systems for enterprise-grade compliance.',
    highlights: [
      'Architectural Threat Modeling & Vulnerability Audits',
      'Shift-Left DevSecOps & Automated CI/CD Scanners',
      'Zero-Trust Network Access & IAM Hardening',
      'SOC 2, ISO 27001 & Data Protection Readiness'
    ]
  },
  {
    image: '/images/service-leadership.jpg',
    icon: `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Fractional CTO & Strategic Advisory',
    outcome: 'High developer velocity · Unbiased tech guidance',
    description: 'Provide executive technical leadership for startups, scale-ups, and enterprises. Guide technology investments, mentor engineering management, and lead due diligence.',
    highlights: [
      'Technology Strategy, Tech Stack & Vendor Selection',
      'Engineering Velocity & DORA Metrics Improvement',
      'Technical Due Diligence for Investors & M&A',
      'Team Topology Design & Senior Engineer Mentorship'
    ]
  }
];

const processSteps = [
  {
    step: '01',
    title: 'Discovery & System Audit',
    description: 'Deep dive into your current architecture, code repositories, deployment pipelines, operational pain points, and commercial milestones.'
  },
  {
    step: '02',
    title: 'Strategic Architecture Blueprint',
    description: 'Formulate an actionable, prioritized roadmap complete with architectural schematics, risk mitigation plans, and measurable business ROI.'
  },
  {
    step: '03',
    title: 'Hands-on Co-Engineering',
    description: 'Work alongside your engineering leads to implement core infrastructure, establish reusable standards, and automate delivery pipelines.'
  },
  {
    step: '04',
    title: 'Validation, Handover & Scale',
    description: 'Execute stress and security testing, conduct comprehensive knowledge transfer with operational runbooks, and provide ongoing advisory.'
  }
];

const engagementModels = [
  {
    name: 'Targeted Technical Audit',
    timeline: '2 – 3 Weeks',
    bestFor: 'Organizations experiencing performance, security, or infrastructure cost issues',
    features: [
      'Full codebase, database & architecture health assessment',
      'Cloud infrastructure cost & security vulnerability scan',
      'Prioritized executive roadmap with quick wins & long-term fixes',
      'Comprehensive debrief session with key technical stakeholders'
    ]
  },
  {
    name: 'Project-Based Transformation',
    timeline: '2 – 6 Months',
    popular: true,
    bestFor: 'Teams executing major migrations, monolith splits, or platform redesigns',
    features: [
      'Full architectural ownership of the transformation initiative',
      'Hands-on implementation of core cloud, API, and pipeline modules',
      'Team pairing, code reviews, and developer upskilling',
      'Guaranteed production launch with SLA benchmarks'
    ]
  },
  {
    name: 'Fractional CTO / Advisory Retainer',
    timeline: 'Ongoing (Monthly)',
    bestFor: 'Founders and executive teams requiring senior technical oversight',
    features: [
      'Weekly architecture reviews and roadmap prioritization',
      'Technical hiring support & senior candidate interviewing',
      'Escalation support for mission-critical architecture decisions',
      'Vendor evaluations and investor presentation advisory'
    ]
  }
];
---

<BlogLayout 
  title="Faysal Ahmed | Senior IT Consultant & Systems Architect" 
  description="Strategic IT consulting, enterprise cloud architecture, cybersecurity, and fractional CTO advisory by Faysal Ahmed."
  fullWidth={true}
>
  <!-- Full-Width Hero Section -->
  <section class="hero-section">
    <div class="content-container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="availability-badge">
            <span class="status-indicator"></span>
            <span>Limited Availability for Consulting & Advisory Engagements</span>
          </div>

          <h1 class="hero-title">
            Strategic IT Consulting for <span class="gradient-text">Resilient, High-Performance Systems</span>
          </h1>

          <p class="hero-lead">
            I partner with business executives and engineering teams to modernize legacy architectures, execute zero-downtime cloud migrations, fortify cybersecurity, and scale resilient software products.
          </p>

          <div class="hero-actions">
            <a href="#contact" class="btn btn-primary" data-analytics-cta="Book Consultation Hero">
              Schedule a Consultation &rarr;
            </a>
            <a href="#services" class="btn btn-secondary" data-analytics-cta="View Services Hero">
              Explore Services
            </a>
            <a href="/blog" class="btn btn-text" data-analytics-cta="Browse Blog Hero">
              Read Technical Insights &rarr;
            </a>
          </div>

          <div class="hero-trust-points">
            <span>✓ 10+ Years Experience</span>
            <span>✓ Vendor-Neutral</span>
            <span>✓ Hands-on Advisory</span>
          </div>
        </div>

        <div class="hero-image-col">
          <div class="hero-image-card">
            <div class="image-glow"></div>
            <img 
              src="/images/faysal-ahmed.jpg" 
              alt="Faysal Ahmed - Senior IT Consultant & Systems Architect" 
              class="hero-profile-img"
              width="400"
              height="480"
              loading="eager"
            />
            <div class="hero-image-overlay">
              <div class="overlay-info">
                <strong>Faysal Ahmed</strong>
                <span>Senior IT Consultant & Architect</span>
              </div>
              <div class="overlay-badge">
                <span class="pulse-dot"></span>
                <span>Active</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Highlights Strip -->
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-title">Cloud & DevOps</span>
          <span class="stat-subtitle">AWS · GCP · Kubernetes · Terraform · CI/CD</span>
        </div>
        <div class="stat-card">
          <span class="stat-title">Enterprise Architecture</span>
          <span class="stat-subtitle">Microservices · Event-Driven · High-Throughput</span>
        </div>
        <div class="stat-card">
          <span class="stat-title">Cybersecurity & Trust</span>
          <span class="stat-subtitle">Zero-Trust · Threat Modeling · DevSecOps</span>
        </div>
        <div class="stat-card">
          <span class="stat-title">Technical Leadership</span>
          <span class="stat-subtitle">Fractional CTO · Roadmapping · Due Diligence</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-Width Services Section -->
  <section id="services" class="section services-section">
    <div class="content-container">
      <div class="section-header">
        <span class="section-tag">CONSULTING SERVICES</span>
        <h2>High-Impact Solutions for Critical Technical Challenges</h2>
        <p>Targeted expertise designed to resolve bottlenecks, lower operating costs, and accelerate your engineering roadmap.</p>
      </div>

      <div class="services-grid">
        {services.map(service => (
          <div class="service-card">
            <div class="service-image-box">
              <img src={service.image} alt={service.title} class="service-thumb" loading="lazy" width="600" height="240" />
              <div class="service-image-gradient"></div>
              <span class="service-outcome-badge">{service.outcome}</span>
            </div>
            <div class="service-card-body">
              <div class="service-header-row">
                <div class="service-icon" set:html={service.icon} />
                <h3>{service.title}</h3>
              </div>
              <p class="service-desc">{service.description}</p>
              <ul class="service-highlights">
                {service.highlights.map(item => (
                  <li>
                    <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full-Width Process Section -->
  <section id="approach" class="section process-section">
    <div class="content-container">
      <div class="section-header">
        <span class="section-tag">ENGAGEMENT PROCESS</span>
        <h2>A Proven, Milestone-Driven Framework</h2>
        <p>Every engagement is executed with absolute transparency, strict technical rigor, and alignment with business objectives.</p>
      </div>

      <div class="process-grid">
        {processSteps.map(step => (
          <div class="process-card">
            <div class="step-num">{step.step}</div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full-Width Business Impact & Audit Spotlight Section -->
  <section class="section impact-section">
    <div class="content-container">
      <div class="impact-grid">
        <div class="impact-image-col">
          <div class="impact-image-wrapper">
            <div class="impact-glow"></div>
            <img 
              src="/images/consulting-audit.jpg" 
              alt="System Architecture & Cloud ROI Audit" 
              class="impact-img" 
              loading="lazy"
              width="600"
              height="420"
            />
            <div class="impact-float-badge badge-top">
              <span class="impact-stat">35% Avg.</span>
              <span class="impact-stat-desc">Cloud Spend Reduction Post-Audit</span>
            </div>
            <div class="impact-float-badge badge-bottom">
              <span class="impact-stat">99.99%</span>
              <span class="impact-stat-desc">High-Availability Architecture</span>
            </div>
          </div>
        </div>

        <div class="impact-content-col">
          <span class="section-tag">BUSINESS IMPACT</span>
          <h2>Technology Engineered for Tangible ROI</h2>
          <p class="impact-lead">
            IT consulting should deliver concrete business value, not just theoretical reports. Every architectural milestone is measured against uptime, infrastructure costs, and delivery speed.
          </p>

          <div class="impact-points">
            <div class="impact-point">
              <div class="impact-check-icon">✓</div>
              <div class="impact-point-text">
                <strong>Eliminate Expensive Architecture Redos</strong>
                <p>Avoid costly technical debt by establishing scalable distributed data models, caching layers, and clear boundaries from day one.</p>
              </div>
            </div>
            <div class="impact-point">
              <div class="impact-check-icon">✓</div>
              <div class="impact-point-text">
                <strong>Accelerate Engineering Velocity</strong>
                <p>Streamlined CI/CD automation and containerized environments take deployment lead times from weeks to minutes with zero downtime.</p>
              </div>
            </div>
            <div class="impact-point">
              <div class="impact-check-icon">✓</div>
              <div class="impact-point-text">
                <strong>Direct Senior Execution</strong>
                <p>Partner directly with an experienced principal architect and systems leader — no junior delegation or agency overhead.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full-Width Engagement Models Section -->
  <section class="section models-section">
    <div class="content-container">
      <div class="section-header">
        <span class="section-tag">COLLABORATION FORMATS</span>
        <h2>Flexible Engagement Models</h2>
        <p>Engage in the structure that best fits your immediate challenges, budget, and internal team capabilities.</p>
      </div>

      <div class="models-grid">
        {engagementModels.map(model => (
          <div class={`model-card ${model.popular ? 'featured' : ''}`}>
            {model.popular && <div class="popular-badge">Most Requested</div>}
            <div class="model-header">
              <h3>{model.name}</h3>
              <span class="model-timeline">{model.timeline}</span>
            </div>
            <p class="model-best-for">{model.bestFor}</p>
            <ul class="model-features">
              {model.features.map(feat => (
                <li>
                  <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
            <a href="#contact" class={`btn ${model.popular ? 'btn-primary' : 'btn-outline'}`} data-analytics-cta={`Choose Model ${model.name}`}>
              Inquire About This Format &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Full-Width Insights Section -->
  <section id="insights" class="section insights-section">
    <div class="content-container">
      <div class="section-header flex-header">
        <div>
          <span class="section-tag">THOUGHT LEADERSHIP</span>
          <h2>Architecture & Engineering Insights</h2>
          <p>Practical guides, architectural case studies, and engineering leadership essays.</p>
        </div>
        <a href="/blog" class="all-link" data-analytics-cta="View all insights">Browse all articles &rarr;</a>
      </div>

      <div class="insights-grid">
        {posts.map((post, idx) => (
          <article class="insight-card">
            <div class="insight-thumb-box">
              <img 
                src={postThumbnails[idx % postThumbnails.length]} 
                alt={post.data.title} 
                class="insight-thumb" 
                loading="lazy" 
                width="600" 
                height="220" 
              />
            </div>
            <div class="insight-body">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <h3>
                <a href={`/blog/${post.id}`} data-analytics-post={post.data.title}>
                  {post.data.title}
                </a>
              </h3>
              <p>{post.data.description}</p>
              <div class="tags">
                {post.data.tags.slice(0, 3).map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Full-Width Contact / CTA Section -->
  <section id="contact" class="section contact-section">
    <div class="content-container">
      <div class="contact-card">
        <span class="section-tag-light">INITIATE CONSULTATION</span>
        <h2>Ready to Modernize Your Technology Strategy?</h2>
        <p class="contact-intro">
          Whether you require an architectural audit, a seamless cloud migration, or ongoing senior advisory, let's schedule an introductory discussion.
        </p>

        <div class="contact-actions">
          <a 
            href="mailto:faysal.ahmed833@gmail.com?subject=IT%20Consulting%20Inquiry" 
            class="btn btn-contact-primary"
            data-analytics-cta="Email Consultation"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            faysal.ahmed833@gmail.com
          </a>
          <a 
            href="https://www.linkedin.com/in/faysalahmedshohel/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn-contact-secondary"
            data-analytics-cta="LinkedIn Profile"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.6 1.6 0 1 0 0-3.2 1.6 1.6 0 0 0 0 3.2m1.4 9.74V9.93H5.06v8.57h2.8z"/></svg>
            Connect on LinkedIn
          </a>
        </div>

        <div class="contact-meta">
          <span>⚡ Prompt response within 24 business hours</span>
          <span>🔒 Strict NDAs & IP confidentiality honored</span>
          <span>🌐 Available for remote & international engagements</span>
        </div>
      </div>
    </div>
  </section>
</BlogLayout>

<script>
  import { track } from '../scripts/analytics.js';
  document.querySelectorAll('[data-analytics-post]').forEach(el => {
    el.addEventListener('click', () => track('post_click', { post_title: el.dataset.analyticsPost, location: 'home' }));
  });
  document.querySelectorAll('[data-analytics-cta]').forEach(el => {
    el.addEventListener('click', () => track('cta_click', { cta_label: el.dataset.analyticsCta, location: 'home' }));
  });
</script>

<style>
  /* Full-Width Layout & Containers */
  .content-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  .section {
    padding: 5rem 0;
    width: 100%;
  }

  .section-header {
    margin-bottom: 3rem;
  }
  .section-header h2 {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text);
    margin: 0.5rem 0 0.75rem 0;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }
  .section-header p {
    color: var(--muted);
    font-size: 1.125rem;
    max-width: 760px;
    line-height: 1.6;
  }
  .flex-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .section-tag {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #0284c7;
    background: rgba(2, 132, 199, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    display: inline-block;
  }

  /* Hero Section */
  .hero-section {
    padding: 5rem 0 5.5rem 0;
    background: radial-gradient(circle at 85% 15%, rgba(14, 165, 233, 0.12), transparent 45%),
                radial-gradient(circle at 15% 85%, rgba(30, 58, 138, 0.08), transparent 40%),
                #ffffff;
    border-bottom: 1px solid var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
    margin-bottom: 4.5rem;
  }
  .hero-content {
    max-width: 100%;
  }
  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(2, 132, 199, 0.08);
    color: #0369a1;
    border: 1px solid rgba(2, 132, 199, 0.25);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.75rem;
  }
  .status-indicator {
    width: 8px;
    height: 8px;
    background: #0ea5e9;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.3);
  }
  .hero-title {
    font-size: 3.25rem;
    font-weight: 850;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--text);
    margin-bottom: 1.35rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, #0284c7 0%, #1d4ed8 50%, #1e3a8a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-lead {
    font-size: 1.2rem;
    color: #475569;
    line-height: 1.75;
    max-width: 860px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .hero-trust-points {
    display: flex;
    gap: 1.5rem;
    font-size: 0.88rem;
    color: #64748b;
    font-weight: 600;
    flex-wrap: wrap;
  }

  /* Hero Image Column */
  .hero-image-col {
    display: flex;
    justify-content: center;
    position: relative;
  }
  .hero-image-card {
    position: relative;
    border-radius: 22px;
    background: #ffffff;
    padding: 8px;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12), 0 4px 12px rgba(15, 23, 42, 0.06);
    border: 1px solid rgba(15, 23, 42, 0.08);
    max-width: 380px;
    width: 100%;
  }
  .image-glow {
    position: absolute;
    inset: -12px;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.35), rgba(30, 58, 138, 0.3));
    border-radius: 30px;
    filter: blur(20px);
    z-index: -1;
    opacity: 0.8;
  }
  .hero-profile-img {
    width: 100%;
    height: 440px;
    object-fit: cover;
    object-position: center 25%;
    border-radius: 16px;
    display: block;
  }
  .hero-image-overlay {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #ffffff;
    padding: 0.85rem 1.15rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }
  .overlay-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .overlay-info strong {
    font-size: 0.95rem;
    color: #ffffff;
    letter-spacing: -0.01em;
  }
  .overlay-info span {
    font-size: 0.78rem;
