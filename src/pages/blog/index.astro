---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<BlogLayout title="Blog" description="All blog posts by Faysal Ahmed.">
  <section class="header">
    <h1>Blog</h1>
    <p>Thoughts on software, systems, and solving real problems.</p>
  </section>

  <div class="search-section">
    <input type="text" id="blog-search" class="search-input" placeholder="Search posts..." autocomplete="off" />
  </div>

  <section class="tags">
    <span class="tag-label">Filter by tag:</span>
    <span class="tag active" data-tag="" data-analytics-filter="">All</span>
    {allTags.map(tag => <span class="tag" data-tag={tag} data-analytics-filter={tag}>{tag}</span>)}
  </section>

  <ul class="post-list">
    {posts.map(post => (
      <li data-blog-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
        <article>
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
          <h2><a href={`/blog/${post.id}`} data-analytics-post={post.data.title}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="tag-list">
              {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          )}
        </article>
      </li>
    ))}
  </ul>
</BlogLayout>

<script>
  import { track } from '../../scripts/analytics.js';

  const searchInput = document.getElementById('blog-search');
  const tagEls = document.querySelectorAll('.tags .tag');
  const postEls = document.querySelectorAll('.post-list li');

  function filterPosts() {
    const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
    const activeTag = document.querySelector('.tags .tag.active');
    const selectedTag = activeTag ? activeTag.dataset.tag : '';

    postEls.forEach(post => {
      const searchText = post.dataset.blogSearch || '';
      const postTags = [...post.querySelectorAll('.tag-list .tag')].map(t => t.textContent);
      const matchesSearch = !q || searchText.includes(q);
      const matchesTag = !selectedTag || postTags.includes(selectedTag);
      post.style.display = matchesSearch && matchesTag ? '' : 'none';
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterPosts);
  }

  tagEls.forEach(tag => {
    tag.addEventListener('click', () => {
      const selected = tag.dataset.tag;
      track('tag_filter', selected ? { tag: selected } : { tag: 'all' });
      tagEls.forEach(t => t.classList.remove('active'));
      tag.classList.add('active');
      filterPosts();
    });
  });

  document.querySelectorAll('[data-analytics-post]').forEach(el => {
    el.addEventListener('click', () => track('post_click', { post_title: el.dataset.analyticsPost, location: 'blog_index' }));
  });
</script>

<style>
  .header { margin-bottom: 2rem; }
  .search-section { margin-bottom: 1.5rem; }
  .search-input {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 1rem;
    font-family: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .search-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(15, 185, 162, 0.12);
  }
  .search-input::placeholder {
    color: var(--muted);
    opacity: 0.7;
  }
  .header h1 { font-size: 2rem; margin-bottom: 0.5rem; }
  .header p { color: var(--muted); }
  .tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .tag-label {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .tag {
    font-size: 0.8rem;
    color: var(--muted);
    background: rgba(2, 6, 23, 0.04);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background 0.15s, color 0.15s;
  }
  .tag:hover { background: rgba(2, 6, 23, 0.08); }
  .tag.active {
    background: linear-gradient(90deg, var(--primary), var(--accent));
    color: #fff;
    border-color: transparent;
  }
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .post-list article time {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .post-list article h2 {
    font-size: 1.25rem;
  }
  .post-list article h2 a { color: var(--text); }
  .post-list article h2 a:hover { color: var(--accent); }
  .post-list article p {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.35rem;
  }
  .tag-list {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .tag-list .tag {
    font-size: 0.75rem;
    cursor: default;
    background: rgba(2, 6, 23, 0.04);
  }
</style>
