---
import BlogLayout from '../../layouts/BlogLayout.astro';

const books = [
  {
    title: 'Fundamentals of Solution Architecture',
    description: 'A practical guide covering the full lifecycle of architectural thinking — from the role of the architect to designing, documenting, and evolving complex systems.',
    slug: 'fosa',
    chapters: 10,
  },
  {
    title: 'Fundamentals of Product Management',
    description: 'A practical guide covering the full product lifecycle — from understanding the PM role and defining strategy to running discovery, prioritising work, launching products, and growing your career.',
    slug: 'fopm',
    chapters: 10,
  },
  {
    title: 'Human AI Interaction',
    description: 'Designing human-centered AI systems and interactions.',
    slug: 'hai',
    chapters: 10,
  },
  {
    title: 'Fundamentals of Mobile Product Management',
    description: 'A practical guide covering the mobile product lifecycle — platform strategy, app store dynamics, monetisation, growth, and retention on iOS and Android.',
    slug: 'fmopm',
    chapters: 10,
  },
  {
    title: 'Fundamentals of Python',
    description: 'A hands-on guide to Python programming — from syntax and data structures to OOP, modules, and real-world libraries.',
    slug: 'fopy',
    chapters: 10,
  },
];
---

<BlogLayout title="Books" description="Books and guides by Faysal Ahmed.">
  <section class="hero">
    <h1>Books</h1>
    <p>In-depth guides covering software architecture, product management, and more.</p>
  </section>

  <div class="search-section">
    <div id="search"></div>
  </div>

  <section class="book-list">
    {books.map(book => (
      <article>
        <h2><a href={`/${book.slug}/`} data-analytics-book={book.slug}>{book.title}</a></h2>
        <p>{book.description}</p>
        <span class="meta">{book.chapters} chapters</span>
      </article>
    ))}
  </section>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <script is:inline type="module">
    import { PagefindUI } from '/pagefind/pagefind-ui.js';

    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      resetStyles: false,
    });
  </script>
</BlogLayout>

<script>
  import { track } from '../../scripts/analytics.js';
  document.querySelectorAll('[data-analytics-book]').forEach(el => {
    el.addEventListener('click', () => track('book_click', { book: el.dataset.analyticsBook }));
  });
</script>

<style>
  .hero {
    margin-bottom: 3rem;
  }
  .hero h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }
  .hero p {
    color: var(--muted);
    max-width: 600px;
  }
  .book-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .book-list article {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .book-list article:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(2, 6, 23, 0.06);
  }
  .book-list h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .book-list h2 a {
    color: var(--text);
  }
  .book-list h2 a:hover {
    color: var(--accent);
  }
  .book-list p {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    max-width: 600px;
  }
  .search-section {
    margin-bottom: 2.5rem;
  }

  /* Pagefind UI overrides */
  :global(.pagefind-ui__search-input) {
    border: 1px solid var(--border) !important;
    border-radius: 10px !important;
    padding: 0.85rem 1rem !important;
    font-size: 1rem !important;
    font-family: inherit !important;
    background: var(--surface) !important;
    color: var(--text) !important;
  }
  :global(.pagefind-ui__search-clear) {
    padding: 0.5rem !important;
  }
  :global(.pagefind-ui__search-clear svg) {
    width: 18px !important;
    height: 18px !important;
  }
  :global(.pagefind-ui__drawer) {
    margin-top: 1rem !important;
  }
  :global(.pagefind-ui__result) {
    border: 1px solid var(--border) !important;
    border-radius: 12px !important;
    padding: 1.25rem !important;
    margin-bottom: 0.75rem !important;
    background: var(--surface) !important;
    transition: box-shadow 0.15s ease !important;
  }
  :global(.pagefind-ui__result:hover) {
    box-shadow: 0 8px 24px rgba(2, 6, 23, 0.06) !important;
  }
  :global(.pagefind-ui__result-title) {
    font-size: 1.1rem !important;
    font-weight: 600 !important;
    color: var(--text) !important;
  }
  :global(.pagefind-ui__result-title a) {
    color: var(--accent) !important;
    text-decoration: none !important;
  }
  :global(.pagefind-ui__result-title a:hover) {
    text-decoration: underline !important;
  }
  :global(.pagefind-ui__result-excerpt) {
    color: var(--muted) !important;
    font-size: 0.9rem !important;
    line-height: 1.7 !important;
    margin-top: 0.5rem !important;
  }
  :global(.pagefind-ui__result-excerpt mark) {
    background: rgba(15, 185, 162, 0.15) !important;
    color: var(--text) !important;
    padding: 0.1em 0.2em !important;
    border-radius: 4px !important;
  }
  :global(.pagefind-ui__message) {
    color: var(--muted) !important;
    font-size: 0.9rem !important;
    text-align: center !important;
    padding: 2rem !important;
  }

  .meta {
    font-size: 0.8rem;
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
